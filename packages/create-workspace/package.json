  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "create-workspace": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "AGENTS.md",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "sync-templates": "node scripts/sync-templates.mjs",
    "build": "node scripts/sync-templates.mjs && tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/sync-templates.mjs && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
