{
  "name": "@scope/pdf",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint:pkg": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@scope/react": "workspace:^",
    "react": "^19.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@scope/core": "workspace:*",
    "@scope/react": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "postcss-nesting": "14.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest-browser-react": "2.3.0"
  }
}
