{
  "name": "@scope/template",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "lint:pkg": "publint && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@scope/react": "workspace:^",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@scope/react": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "react": "19.3.1"
  }
}
