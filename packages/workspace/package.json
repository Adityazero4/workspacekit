{
  "name": "@workspacekit/workspace",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "author": "Aditya Jain <adityajain042001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adityazero4/workspacekit.git",
    "directory": "packages/workspace"
  },
  "homepage": "https://docs-ashy-alpha.vercel.app",
  "bugs": "https://github.com/Adityazero4/workspacekit/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "lint:pkg": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "size": "size-limit",
    "consumer:dist": "node scripts/consumer-dist.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@workspacekit/code": "workspace:*",
    "@workspacekit/core": "workspace:*",
    "@workspacekit/docx": "workspace:*",
    "@workspacekit/markdown": "workspace:*",
    "@workspacekit/pdf": "workspace:*",
    "@workspacekit/pptx": "workspace:*",
    "@workspacekit/react": "workspace:*",
    "@workspacekit/spreadsheet": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4",
    "vitest-browser-react": "2.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
