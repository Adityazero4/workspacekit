{
  "name": "@scope/demo-kit",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt"
