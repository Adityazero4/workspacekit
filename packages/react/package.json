{
  "name": "@workspacekit/react",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Aditya Jain <adityajain042001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adityazero4/workspacekit.git",
    "directory": "packages/react"
  },
  "homepage": "https://docs-ashy-alpha.vercel.app",
  "bugs": "https://github.com/Adityazero4/workspacekit/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderers": {
      "types": "./dist/renderers/index.d.ts",
      "default": "./dist/renderers/index.js"
    },
    "./renderer-kit": {
      "types": "./dist/renderer-kit/index.d.ts",
      "default": "./dist/renderer-kit/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "lint:pkg": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "bench": "node bench/run.mjs",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@workspacekit/core": "workspace:*",
    "@tanstack/react-virtual": "3.14.21",
    "utif2": "4.1.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/plugin-transform-runtime": "8.0.6",
    "@babel/runtime": "8.0.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4",
    "vitest-browser-react": "2.3.0"
  }
}
