{
  "name": "@workspacekit/markdown",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Aditya Jain <adityajain042001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adityazero4/workspacekit.git",
    "directory": "packages/markdown"
  },
  "homepage": "https://docs-ashy-alpha.vercel.app",
  "bugs": "https://github.com/Adityazero4/workspacekit/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "lint:pkg": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@workspacekit/react": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@workspacekit/core": "workspace:*",
    "@workspacekit/react": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest-browser-react": "2.3.0"
  },
  "dependencies": {
    "@lexical/code-core": "0.52.0",
    "@lexical/extension": "0.52.0",
    "@lexical/history": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/utils": "0.52.0",
    "lexical": "0.52.0"
  }
}
