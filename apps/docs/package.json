    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.5",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "axe-core": "4.14.0",
    "tailwindcss": "4.3.3",
